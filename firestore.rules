rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile rules
    match /users/{userId} {
      // Authenticated users can read any user profile (required for search & displaying chat names/avatars)
      allow read: if request.auth != null;
      // Users can only create or update their own profile document
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // Conversation rules
    match /conversations/{conversationId} {
      // Allow read/update if the authenticated user is one of the participants
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      // Allow create if authenticated user is one of the participants
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      // Allow update if user is participant (e.g. updating lastMessage, unreadCounts)
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Messages subcollection rules
      match /messages/{messageId} {
        // Read if user is a participant of the parent conversation
        allow read: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Create if user is authenticated and matches the senderId
        allow create: if request.auth != null && 
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        // Update:
        // 1) Sender can soft-delete their own message
        // 2) Any participant can update read state (isRead, readAt), reactions, or game metadata
        allow update: if request.auth != null && (
          // Sender updating (e.g. soft delete)
          request.auth.uid == resource.data.senderId ||
          // Receiver updating read status or participants toggling reactions/game answers
          (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'reactions', 'metadata'])
          )
        );

        // Disallow hard deletion to preserve message synchronization order
        allow delete: if false;
      }
    }

    // Stickers collection rules (creator owned)
    match /stickers/{stickerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Message capsules collection rules
    match /capsules/{capsuleId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.senderId;
    }

    // Call signaling & history rules
    match /calls/{callId} {
      // Read allowed only for call participants
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.participants);

      // Create allowed only if callerId matches authenticated user
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.callerId &&
        request.auth.uid in request.resource.data.participants;

      // Update allowed only for participants (e.g. accepting, rejecting, ending)
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      allow delete: if false;

      // Signaling candidates subcollections
      match /callerCandidates/{candidateId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }

      match /receiverCandidates/{candidateId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
      }
    }
  }
}
